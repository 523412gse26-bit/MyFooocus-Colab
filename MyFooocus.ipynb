import sys
import subprocess
import os

print("🐍 Python:", sys.version)

print("\n📦 Installing dependencies...")

subprocess.run([
    sys.executable, "-m", "pip", "install", "-U",
    "numpy",
    "cupy-cuda12x",
    "pygit2"
], check=True)

FOOCUS_DIR = "/content/Fooocus"

if not os.path.exists(FOOCUS_DIR):
    print("\n⬇️ Downloading Fooocus...")
    subprocess.run([
        "git", "clone",
        "https://github.com/lllyasviel/Fooocus.git",
        FOOCUS_DIR
    ], check=True)
else:
    print("\n✅ Fooocus already exists.")

os.chdir(FOOCUS_DIR)

requirements_file = "requirements_versions.txt"

with open(requirements_file, "a") as f:
    f.write("\nfastapi==0.104.1\n")
    f.write("starlette==0.27.0\n")
    f.write("pydantic==1.10.19\n")

print("\n✅ Environment ready!")
print("\n🚀 Starting Fooocus...\n")

subprocess.run([
    sys.executable,
    "entry_with_update.py",
    "--share",
    "--always-high-vram",
    "--all-in-fp16",
    "--listen"
])
